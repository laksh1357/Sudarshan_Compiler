{
  "buildCommand": "mkdir -p dist && cp index.html style.css app.js dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "src/**,backend/**,examples/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    }
  ]
}
