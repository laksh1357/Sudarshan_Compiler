{
  "functions": {
    "api/index.py": {
      "includeFiles": "src/**,backend/**,examples/**,index.html,style.css,app.js,api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
