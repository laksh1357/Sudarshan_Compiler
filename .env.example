# Sudarshan Compiler Studio - Environment Configuration Example

# Backend Port and Host
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or * for development)
# For production: set to your deployed frontend URL (e.g., https://sudarshan-studio.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Virtual Machine Max Execution Steps (Infinite Loop Protection)
VM_MAX_STEPS=100000
